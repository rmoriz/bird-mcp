# Optional: use an OpenCode Go API key instead of importing the host login.
# Copy this file to .env (gitignored) and fill in what you need.
#
# Get the key from https://opencode.ai/console (OpenCode Go subscription).
OPENCODE_API_KEY=

# Other providers, if you want them in the container:
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# OPENROUTER_API_KEY=
